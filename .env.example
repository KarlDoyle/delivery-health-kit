# Delivery Health Kit — live credentials (LIVE MODE ONLY)
#
# The default `report` command runs fully OFFLINE against fixtures/ and needs
# NONE of these. Fill these in only to run `dhk report --live`.
# Never commit real values — this file holds placeholders only.

# --- GitHub (PR / cycle-time / review metrics) ---
# A classic or fine-grained PAT with read access to the repos below.
GITHUB_TOKEN=
GITHUB_ORG=
# Comma-separated "org/repo" paths, e.g. acme/web,acme/api
GITHUB_REPOS=
# Comma-separated GitHub usernames (the team), e.g. alice,bob
TEAM_MEMBERS=

# --- Jira (sprint / throughput / lead-time / work-mix metrics) ---
JIRA_BASE_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
# Optional: board id to resolve the active sprint name
JIRA_BOARD_ID=

# --- Slack (support-channel intelligence + report delivery) ---
# Bot token (xoxb-...) with channels:history / users:read for support scan,
# and chat:write to post the report.
SLACK_BOT_TOKEN=
SLACK_SUPPORT_CHANNEL_ID=
SLACK_REPORT_CHANNEL_ID=

# --- DORA (deployment frequency / lead time / change-failure rate) ---
# Live DORA reads deploy events from BigQuery (Drone build data).
GCP_PROJECT_ID=
BIGQUERY_DATASET=
# Optional path to a service-account key; omit to use Application Default Creds.
GOOGLE_APPLICATION_CREDENTIALS=
