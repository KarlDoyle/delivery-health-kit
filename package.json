{
  "name": "eng-baseline",
  "version": "0.2.0",
  "description": "Engineering-health insight your team installs in five minutes — DORA, delivery and on-call metrics as DX Core 4, team-level only, and your data never leaves your machine. Runs fully offline against committed synthetic fixtures.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "bin": {
    "dhk": "./dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dhk": "node --import tsx/esm src/index.ts",
    "report": "node --import tsx/esm src/index.ts report --offline",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "e2e": "bash scripts/e2e-smoke.sh",
    "size": "node scripts/check-size.mjs",
    "review": "node scripts/review.mjs --rubric docs/review-rubric.md",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
